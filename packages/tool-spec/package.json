{
  "name": "@deepseek-ai/dsh-tool-spec",
  "description": "Model-facing project-delivery spec tools (list/read/save/decide) over the durable spec store",
  "version": "0.1.0-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/spec/tool-spec"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/dsh-invariants": "*",
    "@deepseek-ai/dsh-spec": "workspace:*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/cordis": "*"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-invariants": "*",
    "@deepseek-ai/dsh-spec": "workspace:*",
    "@deepseek-ai/dsh-storage": "*",
    "@deepseek-ai/dsh-storage-domain": "*",
    "@deepseek-ai/dsh-storage-json": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/cordis": "*"
  }
}
